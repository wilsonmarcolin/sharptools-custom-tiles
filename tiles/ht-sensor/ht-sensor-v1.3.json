<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="description" content="Temperature & Humidity Monitor v1.3 - Optimized monitoring tile for SharpTools">
  <title>Temperature & Humidity Monitor v1.3</title>

  <!-- Tile Settings Configuration -->
  <script type="application/json" id="tile-settings">
  {
    "schema": "0.2.0",
    "settings": [
      {
        "type": "THING",
        "name": "device",
        "label": "Temperature & Humidity Device",
        "filters": {"capabilities": ["temperatureMeasurement", "relativeHumidityMeasurement"]}
      },
      {
        "type": "STRING",
        "name": "temperatureUnit",
        "label": "Temperature Unit (C or F)",
        "default": "C"
      },
      {
        "type": "NUMERIC",
        "name": "refreshInterval",
        "default": 5,
        "label": "Refresh Interval (minutes)"
      },
      {
        "type": "BOOLEAN",
        "name": "showLabels",
        "default": false,
        "label": "Show TEMP/HUM Labels"
      }
    ],
    "name": "Temperature & Humidity Monitor v1.3",
    "dimensions": {"width": 1, "height": 1}
  }
  </script>

  <!-- SharpTools Library -->
  <script src="https://cdn.sharptools.io/js/custom-tiles/0.2.1/stio.js"></script>

  <style>
  /* ============================================
     RESET & BASE STYLES
     ============================================ */
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    -webkit-tap-highlight-color: transparent;
    user-select: none;
  }

  /* ============================================
     CSS VARIABLES - UNIFIED DESIGN SYSTEM
     ============================================ */
  :root {
    /* Dynamic scaling with single multiplier */
    --scale: 1;
    
    /* Base size unit for all calculations */
    --base: calc(1rem * var(--scale));
    
    /* Typography using base multipliers */
    --font-value: calc(var(--base) * 1.96);
    --font-unit: calc(var(--base) * 0.84);
    --font-label: calc(var(--base) * 0.49);
    
    /* Spacing using base */
    --spacing: calc(var(--base) * 0.35);
    
    /* Color palette */
    --text: #FFFFFF;
    --cold: #4FC3F7;
    --hot: #FF5252;
    --alert: #FFE66D;
    --divider: rgba(255, 255, 255, 0.3);
    
    /* Effects */
    --shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
    --transition: 350ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* ============================================
     GLOBAL STYLES
     ============================================ */
  html, body {
    height: 100%;
    overflow: hidden;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-weight: 400;
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
  }

  body {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* ============================================
     CONTAINER & LAYOUT
     ============================================ */
  .container {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    color: var(--text);
    background: transparent;
    padding: var(--spacing);
    padding-top: calc(var(--spacing) * 3);
  }

  .view {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  /* ============================================
     DATA SECTIONS
     ============================================ */
  .section {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100%;
    position: relative;
  }

  .section.temp {
    justify-content: flex-end;
    padding-bottom: calc(var(--spacing) * 0.5);
  }

  .section.hum {
    justify-content: flex-start;
    padding-top: calc(var(--spacing) * 0.5);
  }

  .divider {
    width: 60%;
    height: 1px;
    background: var(--divider);
    margin: calc(var(--spacing) * 0.5) 0;
  }

  /* ============================================
     VALUE DISPLAYS
     ============================================ */
  .display {
    display: flex;
    align-items: baseline;
    gap: calc(var(--spacing) * 0.3);
    transition: color var(--transition);
  }

  .value {
    font-size: var(--font-value);
    font-weight: 400;
    line-height: 1;
    text-shadow: var(--shadow);
  }

  .unit {
    font-size: calc(var(--font-value) * 0.4);
    font-weight: 400;
    opacity: 0.9;
  }

  /* Humidity specific */
  .display.hum {
    flex-direction: column;
    align-items: center;
    gap: calc(var(--spacing) * 0.2);
  }

  .display.hum .unit {
    font-size: var(--font-unit);
    opacity: 0.8;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* ============================================
     STATES & ANIMATIONS
     ============================================ */
  .display.cold { color: var(--cold); }
  .display.hot { color: var(--hot); }

  .display.alert .value,
  .display.alert .unit {
    animation: pulse 2s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { 
      color: var(--text);
      transform: scale(1);
    }
    50% { 
      color: var(--alert);
      transform: scale(1.05);
    }
  }

  /* Labels */
  .label {
    font-size: var(--font-label);
    font-weight: 600;
    opacity: 0.6;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: calc(var(--spacing) * 0.5);
  }

  /* ============================================
     LOADING & ERROR STATES
     ============================================ */
  .spinner {
    width: calc(var(--base) * 2.1);
    height: calc(var(--base) * 2.1);
    border: 3px solid rgba(255, 255, 255, 0.3);
    border-top-color: var(--text);
    border-radius: 50%;
    animation: spin 1s linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  .error {
    font-size: calc(var(--base) * 0.7);
    opacity: 0.9;
    text-align: center;
    padding: var(--spacing);
  }

  /* ============================================
     UTILITY CLASSES
     ============================================ */
  .hidden { display: none !important; }

  /* ============================================
     RESPONSIVE & ACCESSIBILITY
     ============================================ */
  @media (hover: hover) and (pointer: fine) {
    .value { font-size: calc(var(--font-value) * 1.1); }
  }

  @media (prefers-reduced-motion: reduce) {
    * {
      animation-duration: 0.01ms !important;
      transition-duration: 0.01ms !important;
    }
  }

  @media (prefers-contrast: high) {
    .container { border: 2px solid var(--text); }
  }
  </style>
</head>
<body>
  <div id="container" class="container">
    <!-- Loading -->
    <div id="loading" class="view">
      <div class="spinner"></div>
    </div>

    <!-- Error -->
    <div id="error" class="view hidden">
      <div class="error">Device configuration required</div>
    </div>

    <!-- Monitor -->
    <div id="monitor" class="view hidden">
      <!-- Temperature -->
      <div class="section temp">
        <div class="label hidden" id="tempLabel">TEMP</div>
        <div class="display" id="tempDisplay">
          <span class="value" id="tempValue">--</span>
          <span class="unit" id="tempUnit">°C</span>
        </div>
      </div>

      <!-- Divider -->
      <div class="divider"></div>

      <!-- Humidity -->
      <div class="section hum">
        <div class="label hidden" id="humLabel">HUM</div>
        <div class="display hum" id="humDisplay">
          <span class="value" id="humValue">--</span>
          <span class="unit">%RH</span>
        </div>
      </div>
    </div>
  </div>

  <script>
  (function() {
    'use strict';

    /* ============================================
       TEMPERATURE & HUMIDITY MONITOR v1.3
       Optimized Edition
       ============================================ */

    // Configuration
    const Config = {
      device: null,
      unit: 'C',
      interval: 300000,
      labels: false,
      thresholds: {
        cold: { C: 5, F: 41 },
        hot: { C: 29, F: 84 },
        humidity: 60
      }
    };

    // State
    const State = {
      temp: null,
      hum: null,
      subs: []
    };

    // DOM References
    const DOM = {};

    // Initialize DOM references
    function initDOM() {
      const ids = ['container', 'loading', 'error', 'monitor', 'tempLabel', 'humLabel',
                   'tempDisplay', 'tempValue', 'tempUnit', 'humDisplay', 'humValue'];
      
      ids.forEach(id => {
        DOM[id] = document.getElementById(id);
      });
    }

    // Dynamic Sizing
    const Sizing = {
      init() {
        this.update();
        window.addEventListener('resize', this.debounce(this.update, 250));
      },
      
      update() {
        if (!DOM.container) return;
        
        const size = Math.min(DOM.container.offsetWidth, DOM.container.offsetHeight);
        let scale = 1;
        
        // Simplified scaling logic
        if (size < 100) scale = 0.5;
        else if (size < 150) scale = 0.7;
        else if (size < 200) scale = 0.85;
        else if (size < 350) scale = size / 250;
        else if (size < 500) scale = 1.5;
        else scale = 2;
        
        document.documentElement.style.setProperty('--scale', scale);
      },
      
      debounce(fn, ms) {
        let timer;
        return (...args) => {
          clearTimeout(timer);
          timer = setTimeout(() => fn.apply(this, args), ms);
        };
      }
    };

    // Device Control
    const Device = {
      clear() {
        State.subs.forEach(sub => sub?.off?.());
        State.subs = [];
      },
      
      subscribe(device) {
        if (!device) return false;
        
        // Unified subscription handler
        const handleAttr = (name, altName, stateKey) => {
          const attr = device.attributes?.[name] || device.attributes?.[altName];
          if (!attr) return false;
          
          device.subscribe(device.attributes[name] ? name : altName);
          
          if (attr.value != null) {
            State[stateKey] = parseFloat(attr.value);
          }
          
          attr.onValue(value => {
            if (value != null) {
              State[stateKey] = parseFloat(value);
              Display.update(stateKey);
            }
          });
          
          return true;
        };
        
        const tempOk = handleAttr('temperature', null, 'temp');
        const humOk = handleAttr('humidity', 'relativeHumidity', 'hum');
        
        return tempOk || humOk;
      }
    };

    // Display Control
    const Display = {
      update(type) {
        if (type === 'temp' || !type) this.updateTemp();
        if (type === 'hum' || !type) this.updateHum();
      },
      
      updateTemp() {
        const val = State.temp;
        DOM.tempValue.textContent = val != null ? val.toFixed(1) : '--';
        DOM.tempUnit.textContent = `°${Config.unit}`;
        
        // Color coding
        DOM.tempDisplay.className = 'display';
        if (val != null) {
          if (val <= Config.thresholds.cold[Config.unit]) {
            DOM.tempDisplay.classList.add('cold');
          } else if (val >= Config.thresholds.hot[Config.unit]) {
            DOM.tempDisplay.classList.add('hot');
          }
        }
      },
      
      updateHum() {
        const val = State.hum;
        DOM.humValue.textContent = val != null ? Math.round(val) : '--';
        
        // Alert state
        DOM.humDisplay.className = 'display hum';
        if (val > Config.thresholds.humidity) {
          DOM.humDisplay.classList.add('alert');
        }
      },
      
      showView(name) {
        ['loading', 'error', 'monitor'].forEach(v => {
          DOM[v]?.classList.toggle('hidden', v !== name);
        });
      },
      
      updateLabels() {
        const hidden = !Config.labels;
        DOM.tempLabel?.classList.toggle('hidden', hidden);
        DOM.humLabel?.classList.toggle('hidden', hidden);
      }
    };

    // Application Controller
    const App = {
      init() {
        initDOM();
        Sizing.init();
        Display.showView('loading');
        
        if (typeof stio === 'undefined') {
          setTimeout(() => this.init(), 200);
          return;
        }
        
        try {
          stio.ready(data => {
            if (this.configure(data.settings)) {
              this.start();
            }
          });
        } catch (e) {
          Display.showView('error');
        }
      },
      
      configure(settings) {
        Config.device = settings.device;
        Config.unit = settings.temperatureUnit || 'C';
        Config.labels = settings.showLabels === true;
        Config.interval = Math.max(settings.refreshInterval || 5, 1) * 60000;
        
        if (!Config.device) {
          Display.showView('error');
          return false;
        }
        
        return true;
      },
      
      start() {
        Device.clear();
        
        if (!Device.subscribe(Config.device)) {
          Display.showView('error');
          return;
        }
        
        Display.updateLabels();
        Display.update();
        Display.showView('monitor');
      }
    };

    // Initialize
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => App.init());
    } else {
      App.init();
    }
    
    // Cleanup
    window.addEventListener('beforeunload', () => Device.clear());

  })();
  </script>
</body>

</html>
